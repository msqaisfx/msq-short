# Public/local configuration only. Put Worker secrets in `.dev.vars` locally
# or use `wrangler secret put` for a Cloudflare environment.
APP_BASE_URL=http://localhost:8787
APP_ENV=local
STAGING_AUTH_REQUIRED=false
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret variable names (intentionally blank)
STAGING_AUTH_CREDENTIALS=
LOGIN_RATE_LIMIT_SECRET=
TURNSTILE_SECRET_KEY=
